# Copy to terraform.tfvars (gitignored) and fill in. Never commit the real file.
account_id   = "123456789012"
alert_emails = ["you@example.com"]

# Turn on after opening Cost Explorer once in the console.
enable_anomaly_detection = false

# Turn on once to prove alert email delivery, then off.
enable_smoke_budget = false
github_owner_id      = 12345678 # gh api users/OWNER --jq .id
